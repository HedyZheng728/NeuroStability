# 复制为 .env，仅保存在服务器。不要提交真实凭据。
ARENA_DOMAIN=
ARENA_PUBLIC_URL=
ARENA_TIMEZONE=Asia/Shanghai
ARENA_ADMIN_PASSWORD=
# 建议用 python -c "import secrets; print(secrets.token_hex(24))" 生成；hex适合数据库URL。
POSTGRES_PASSWORD=
# 腾讯云中国香港 COS：控制台创建私有桶，API 和 Worker 使用同一桶。
S3_BUCKET=
S3_ENDPOINT_URL=https://cos.ap-hongkong.myqcloud.com
AWS_DEFAULT_REGION=ap-hongkong
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ARENA_ENABLE_SAMPLE=false
WITH_POSE=false
WITH_SEGMENTATION=false
WITH_REVIEW=false
WITH_POSE3D=false
WITH_ACTION=false
OMP_NUM_THREADS=4
# 串行载入模型权重，避免 safetensors 跨模型并行初始化死锁；不影响 GPU 推理。
HF_DEACTIVATE_ASYNC_LOAD=1
MPLCONFIGDIR=/tmp/arena-matplotlib
RTMPOSE_DETECTOR=/app/models/rtmpose/detector.onnx
RTMPOSE_MODEL=/app/models/rtmpose/pose.onnx
# FSW 尚无可核实发布权重。填写bundle并不会绕过验证，也不会启用随机分类器。
FSW_BUNDLE=
# 可选本地SAM2官方权重目录，见 scripts/install_sam2.py
SAM2_MODEL_DIR=/app/models/sam2
# 免费本地Qwen复盘：先显式运行 scripts/install_review_model.py --download。
ARENA_REVIEW_MODEL_DIR=/app/models/review
# 官方 MotionBERT Lite 三维骨架：scripts/install_pose3d.py --download
ARENA_POSE3D_MODEL=/app/models/pose3d
# 本地视觉动作候选：scripts/install_vision_action.py --download
ARENA_ACTION_MODEL_DIR=/app/models/vision-action
# 可选语言模型，只发送去标识测量摘要，不发送训练视频。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
